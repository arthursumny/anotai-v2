# AnotAI — variáveis para Dokploy/Compose
# Copie para .env no mesmo diretório do docker-compose.dokploy.yml e preencha.
# Tudo que tem `troque-por...` precisa ser trocado antes do deploy.

# --------------------------------------------- Postgres
POSTGRES_USER=anotai
POSTGRES_PASSWORD=troque-por-senha-forte
POSTGRES_DB=anotai

# --------------------------------------------- JWT
# Gere ≥32 chars; nunca reutilize o segredo de dev nem exponha no repo.
# Sugestão: `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET_KEY=troque-por-segredo-jwt-32-chars

# --------------------------------------------- Chave Fernet de segredos
# Sem ela, a migration F6 (alembic 9c2e7f4a1b63) ABORTA sem alterar dados.
# A MESMA chave precisa estar disponível em API e Worker. Gere uma vez:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
USER_SECRET_ENCRYPTION_KEY=

# --------------------------------------------- Soniox (transcrição)
# STT_PROVIDER aceita apenas "soniox" (produção) ou "fake" (exclusivo de ENV=dev|test).
SONIOX_API_KEY=
SONIOX_STT_MODEL=stt-async-v5
STT_PROVIDER=soniox
# API assíncrona do Soniox: envia o áudio e faz polling até transcrever.
SONIOX_API_BASE_URL=https://api.soniox.com
SONIOX_STT_TIMEOUT_SECONDS=900
SONIOX_STT_POLL_INTERVAL_SECONDS=1

# --------------------------------------------- OpenAI (modelos + documentos)
OPENAI_API_KEY=
OPENAI_ROUTER_MODEL=gpt-4o-mini
OPENAI_EXTRACTOR_MODEL=gpt-4o
OPENAI_TRANSCRIPT_CHUNK_CHARS=24000
# Confiança mínima do roteador para aceitar um modelo (0–1); abaixo disso, nota geral.
ROUTER_CONFIDENCE_THRESHOLD=0.6

# --------------------------------------------- Integrações do usuário (Nango)
# Cada usuário conecta a PRÓPRIA conta. Nenhuma credencial de terceiro mora no
# banco: só uma referência à conexão que o Nango guarda.
# Os e-mails das automações saem da conta Gmail do próprio usuário — não existe
# SMTP da plataforma. Sem a conta conectada, a ação SEND_EMAIL falha explícito.
NANGO_ENV_KEY=
NANGO_SIGNING_KEY=
NANGO_BASE_URL=
NANGO_ENVIRONMENT=
# Identificam, no painel do Nango, qual configuração de integração é cada app.
# Deixe vazio para desativar o app (ele aparece como indisponível, não quebra).
NANGO_GOOGLE_GMAIL_PROVIDER_CONFIG_KEY=
NANGO_GOOGLE_CALENDAR_PROVIDER_CONFIG_KEY=
NANGO_GOOGLE_SHEETS_PROVIDER_CONFIG_KEY=
NANGO_NOTION_PROVIDER_CONFIG_KEY=

# --------------------------------------------- Locale / fuso padrão
DEFAULT_TIMEZONE=America/Sao_Paulo

# ============================================================================
# INTEGRAÇÕES OPCIONAIS — deixe vazio até ligar cada uma
# ============================================================================

# --- Nango (Gmail/Calendar) — só quando você for ligar
# NANGO_ENV_KEY=
# NANGO_BASE_URL=
# NANGO_SIGNING_KEY=
# NANGO_ENVIRONMENT=production
# NANGO_GOOGLE_GMAIL_PROVIDER_CONFIG_KEY=
# NANGO_GOOGLE_CALENDAR_PROVIDER_CONFIG_KEY=

# --- Google PubSub para Gmail push — só quando você for ligar
# GMAIL_PUBSUB_TOPIC=
# GMAIL_PUSH_AUDIENCE=
# GMAIL_PUSH_SA_EMAIL=

# --- Evolution GO 0.7.2 (WhatsApp) — só quando você for ligar
# WHATSAPP_EVOLUTION_BASE_URL=
# WHATSAPP_EVOLUTION_GLOBAL_API_KEY=
# WHATSAPP_TOKEN_ENCRYPTION_KEY=
# WHATSAPP_WEBHOOK_BASE_URL=

# --- MCP legado — só se você for manter MCP além de Nango
# MCP_SERVER_URL=
# MCP_PUBLIC_BASE_URL=https://anotai.exemplo.com
# MCP_WEB_APP_URL=https://anotai.exemplo.com
# MCP_TOKEN_ENCRYPTION_KEY=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
